{
	"name": "lmsjffy",
	"version": "0.0.2",
	"description": "Let me search JTechForums for you.",
	"keywords": [
		"JTechForums",
		"LMSJFFY"
	],
	"homepage": "https://github.com/alltechdev/lmsjffy",
	"bugs": {
		"url": "https://github.com/alltechdev/lmsjffy/issues"
	},
	"license": "AGPL-3.0-or-later",
	"repository": "github:alltechdev/lmsjffy",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"clean": "rm -rf .svelte-kit build node_modules tsconfig.tsbuildinfo",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest --sequence.concurrent",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint --fix . && pnpm run format --list-different",
		"format": "prettier --write .",
		"sync": "svelte-kit sync"
	},
	"devDependencies": {
		"@eslint/js": "^9.21.0",
		"@natoboram/heroicons.svelte": "^1.0.6",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.20.6",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@testing-library/svelte": "^4.2.3",
		"@testing-library/user-event": "^14.6.1",
		"autoprefixer": "^10.4.23",
		"eslint": "^9.21.0",
		"eslint-config-prettier": "^10.0.2",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.11.0",
		"happy-dom": "^20.0.11",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^4.2.19",
		"svelte-check": "^3.8.6",
		"svelte-eslint-parser": "^0.43.0",
		"tailwindcss": "^3.4.18",
		"tslib": "^2.8.1",
		"typescript": "5.8.3",
		"typescript-eslint": "^8.25.0",
		"vite": "^5.4.21",
		"vitest": "^2.1.9"
	},
	"private": true,
	"type": "module"
